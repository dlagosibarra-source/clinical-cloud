# Database
# Local macOS/Homebrew PostgreSQL (no credentials required). Non-local setups may need credentials.
DATABASE_URL=postgresql://localhost:5432/clinical_cloud_dev

# AWS
AWS_REGION=us-east-2

# Auth (AWS Cognito)
# Create a User Pool in us-east-2 and a public App Client (no client secret).
# These are public values, not secrets.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp (Phase 6)
WHATSAPP_VERIFY_TOKEN=clinical_cloud_test_token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# AI (Phase 7)
# AI_PROVIDER=deepseek
# AI_MODEL=deepseek/deepseek-chat
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
